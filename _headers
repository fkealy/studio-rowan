# Cloudflare Pages — https://developers.cloudflare.com/pages/configuration/headers/
# Rules are cumulative; where two rules set the same header for the same
# path, the LAST matching rule in this file wins.

# Nothing external is loaded at runtime: fonts, engine, media and the frame
# sequence are all same-origin. The sha256 covers the one inline script in
# index.html's head, which sets the .js class before first paint and holds the
# page while the spin loads. Recompute it when that script changes: sha256 of
# the bytes between the script tags, base64.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-DKgWP5NrtpS+8feqbxiJ7n/OALUYHzkTnpVO4VKapWY='; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'

# HTML: always revalidate so updates ship immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Top-level app code (styles.css, page.js) changes on every deploy but keeps
# the same filename — always revalidate so visitors get the latest build
# instead of a stale cached copy.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Long-lived assets: these only change when the file is deliberately replaced.
# Declared after the rules above so they take precedence for these paths.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/engine/*
  Cache-Control: public, max-age=31536000, immutable
/spin/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable
